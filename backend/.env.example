# Copy to backend/.env (git-ignored) and fill in. Plain KEY=value lines: NO quotes, NO spaces around "=".
# Every service reads this file from the backend/ directory, and real environment variables win over it.

# --- Local MySQL 8 (see docs/sql/00-create-databases.sql) -------------------------------------------
# JDBC URL, no password in it. Special characters in the password need no encoding here.
DB_URL=jdbc:mysql://localhost:3306/jobtrail?allowPublicKeyRetrieval=true&useSSL=false
DB_USER=jobtrail
DB_PASSWORD=CHANGE_ME

# Used only by `mvn test` (the services' integration tests). The tests wipe this database.
TEST_DB_URL=jdbc:mysql://localhost:3306/jobtrail_test?allowPublicKeyRetrieval=true&useSSL=false
TEST_DB_USER=jobtrail
TEST_DB_PASSWORD=CHANGE_ME

# --- Secrets shared by user-service and tracker-service ---------------------------------------------
# Generate both (e.g.  openssl rand -base64 48). The services refuse to start with these example values.
# JWT signing key (HS256): at least 32 characters. The gateway uses it too (rate limiting per user).
JWT_SECRET=change-me-to-a-long-random-string-0000
# Key for service-to-service /internal calls: at least 32 characters in production.
INTERNAL_API_KEY=change-me-internal-key-0000000000
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30

# --- Ports and URLs ----------------------------------------------------------------------------------
# Public entry point (what the Flutter app talks to).
PORT=3000
USER_SERVICE_PORT=3001
TRACKER_SERVICE_PORT=3002
USER_SERVICE_URL=http://127.0.0.1:3001
TRACKER_SERVICE_URL=http://127.0.0.1:3002
# Used to build absolute avatar URLs; must be https in production.
PUBLIC_BASE_URL=http://localhost:3000

# --- Misc --------------------------------------------------------------------------------------------
UPLOAD_DIR=./uploads
LOG_LEVEL=info
# Gateway limits per minute: the API per user (per IP without a token), password endpoints and token
# endpoints (refresh / device login / logout) per IP. Only trust X-Forwarded-For behind a proxy you control.
AUTH_RATE_LIMIT=10
TOKEN_RATE_LIMIT=120
API_RATE_LIMIT=300
TRUST_FORWARDED_FOR=false
# Largest JSON request body (gateway and services).
MAX_BODY_SIZE=1MB
# Interface the user and tracker services listen on. Keep 127.0.0.1 unless they run on separate hosts
# (then use a private-network address, never a public one).
SERVICE_BIND_ADDRESS=127.0.0.1
# Password hashes running at once (0 = one per CPU core); each needs about 19 MiB.
ARGON2_MAX_CONCURRENT=0
# Shared rate limits for several gateways, e.g. redis://:password@localhost:6379/0. Empty = in memory.
REDIS_URL=
# Read notifications older than this many days are deleted nightly.
NOTIFICATION_RETENTION_DAYS=365
